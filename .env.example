APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Must be false in production — true exposes stack traces on non-API routes.
APP_DEBUG=true
# Must be the real production domain (https://), not localhost — Sanctum's
# stateful-domain check and several config defaults derive from this.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "single" never rotates and grows unbounded — use "daily" in production
# (the "daily" channel already exists below, honoring LOG_DAILY_DAYS).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "debug" is noisy/disk-heavy for production — use "warning" or "error".
LOG_LEVEL=debug
LOG_SECURITY_LEVEL=info
LOG_SECURITY_DAYS=30

# Production requires a real database (mysql/pgsql), not sqlite — uncomment
# and fill in DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset (null) does NOT force HTTPS-only cookies. Set to true in production
# (served over HTTPS) so session cookies are never sent over plain HTTP.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Domains allowed to receive stateful (cookie-based) Sanctum auth. Must
# include the production frontend's domain (scheme-less, host[:port]).
# Includes both the student/landlord app (5173) and the separate Admin/
# Super Admin app (5175) - two frontends, one backend.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5175,127.0.0.1,127.0.0.1:8000,127.0.0.1:5175
SANCTUM_EXPIRATION=

# Origins allowed to call this API cross-origin (CORS). Must be the real
# production frontend URL(s) (with scheme), comma-separated — see
# config/cors.php. Includes both frontends (student/landlord app on 5173,
# Admin/Super Admin app on 5175).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=1
AUTH_REGISTER_MAX_ATTEMPTS=3
AUTH_REGISTER_DECAY_MINUTES=1

SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_SECURITY_POLICY="default-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"

# Set to false in production, or ensure DEMO_DEFAULT_PASSWORD below is changed
# per-deployment — otherwise this seeds a demo admin with a known password.
SEED_DEMO_DATA=true
DEMO_DEFAULT_PASSWORD="ChangeThisDemoPassword!2026"
DEMO_ADMIN_NAME="Admin Phteahnisit"
DEMO_ADMIN_EMAIL=admin@phteahnisit.test
DEMO_ADMIN_PHONE=012345678
DEMO_SUPER_ADMIN_NAME="Super Admin Phteahnisit"
DEMO_SUPER_ADMIN_EMAIL=superadmin@phteahnisit.test
DEMO_SUPER_ADMIN_PHONE=012345679

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
